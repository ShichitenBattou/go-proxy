# Server Settings
BFF_LISTEN_ADDR=:8080
PROXY_TARGET=api:8081

# Authentication (Keycloak/OIDC) Settings
OIDC_PROVIDER_URL=https://auth.local/idp/realms/go-proxy
OAUTH2_CLIENT_ID=api
OAUTH2_CLIENT_SECRET=nNXMU6GnFddXgzBYelgbQqTZc5Y2xzmT
OAUTH2_REDIRECT_URL=https://auth.local/api/auth/callback
OAUTH2_SCOPES=openid,profile,email

# Redis Settings
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
SESSION_TTL=720h  # 30 days (30 * 24h)
SESSION_KEY_PREFIX=session:
STATE_KEY_PREFIX=state:
STATE_TTL=5m  # OAuth2 state token TTL (5 minutes for CSRF protection)

# Session/Cookie Settings
SESSION_COOKIE_NAME=Session-Id
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Strict  # Options: Strict, Lax, None

# CORS Settings
CORS_ALLOW_ORIGIN=https://localhost:3000
CORS_ALLOW_METHODS=GET, POST, PUT, DELETE, OPTIONS

# TLS/Certificate Settings
ROOT_CA_FILE=./rootCA.crt

# Security Settings - Redirect URL Whitelist
# Regex pattern for allowed redirect URLs (leave empty to allow all paths)
# Examples:
#   ^/$                                      # Root only
#   ^/(dashboard|profile|settings)$          # Specific paths only
#   ^/(dashboard|profile|settings)(/.*)?$    # Paths with optional subpaths
#   ^/app/.*$                                # All paths under /app
#   ^/(public|user/[^/]+/dashboard)$         # Complex conditions
#   ^/.*$                                    # All paths (NOT RECOMMENDED for production)
#
# For production, it is HIGHLY RECOMMENDED to set a restrictive pattern
ALLOWED_REDIRECT_PATH_PATTERN=
